<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">
      Панель Супер-Админа
    </h1>
    <p class="mt-2 text-sm text-gray-600">
      Добро пожаловать, <%= current_user.display_name %>!
    </p>
  </div>

  <!-- Глобальная статистика -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Общий баланс системы</dt>
              <dd class="text-lg font-semibold text-gray-900">
                <%= number_to_currency(User.joins(:balance).sum('balances.balance_rub'), unit: "₽", precision: 2) %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Транзакций сегодня</dt>
              <dd class="text-lg font-semibold text-gray-900">
                <%= Transaction.today.completed.count %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Ожидающих заявок</dt>
              <dd class="text-lg font-semibold text-gray-900">
                <%= WithdrawalRequest.pending.count %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Комиссия за месяц</dt>
              <dd class="text-lg font-semibold text-gray-900">
                <%= number_to_currency(Transaction.this_month.completed.sum(:commission_rub), unit: "₽", precision: 2) %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Админы -->
  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Админы</h2>
    <div class="space-y-4">
      <% User.where(role: :admin).each do |admin| %>
        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
          <div>
            <p class="font-medium text-gray-900"><%= admin.display_name %></p>
            <p class="text-sm text-gray-500"><%= admin.email %></p>
          </div>
          <div class="text-right">
            <p class="text-sm font-medium text-gray-900">
              <%= number_to_currency(admin.balance.balance_rub, unit: "₽", precision: 2) %>
            </p>
            <p class="text-xs text-gray-500">
              <%= admin.all_managers_in_cohort.count %> менеджеров
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Быстрые действия -->
  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Быстрые действия</h2>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <%= link_to admin_users_path, class: "flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" do %>
        Управление пользователями
      <% end %>

      <%= link_to admin_exchange_rates_path, class: "flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
        Курсы валют
      <% end %>

      <%= link_to admin_withdrawal_requests_path, class: "flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
        Заявки на вывод
      <% end %>

      <%= link_to admin_statistics_path, class: "flex items-center justify-center px-4 py-3 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
        Статистика
      <% end %>
    </div>
  </div>
</div>

