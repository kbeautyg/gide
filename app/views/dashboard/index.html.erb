<div class="max-w-4xl mx-auto py-8">
  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">🎉 Вы вошли!</h1>
    
    <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
      <p class="text-lg text-gray-700">Добро пожаловать, <strong><%= current_user.full_name %></strong>!</p>
      <p class="text-gray-600 mt-2">Телефон: <%= current_user.phone %></p>
      <p class="text-gray-600">Роль: <span class="badge badge-completed"><%= current_user.role %></span></p>
    </div>

    <div class="space-y-4">
      <h2 class="text-2xl font-semibold text-gray-800">Информация о системе</h2>
      <p class="text-gray-600">FastChange 3.0 работает!</p>
      <p class="text-sm text-gray-500">Время сервера: <%= Time.current.strftime('%d.%m.%Y %H:%M:%S') %></p>
    </div>

    <div class="mt-8">
      <%= button_to "Выйти", destroy_user_session_path, method: :delete, 
          class: "btn-primary px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700" %>
    </div>
  </div>
</div>
