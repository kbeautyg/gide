<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Создать платежную ссылку</h1>
    <p class="text-gray-600 mt-2">Создайте ссылку для оплаты клиентом</p>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <%= form_with model: @payment_link, url: manager_payment_links_path, class: "space-y-6" do |f| %>
      <% if @payment_link.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
          <ul>
            <% @payment_link.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Сумма -->
      <div>
        <%= f.label :amount_from, "Сумма в рублях", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.number_field :amount_from, step: 0.01, placeholder: "10000", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" %>
      </div>

      <!-- Курс -->
      <div>
        <%= f.label :rate, "Курс (RUB → THB)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.number_field :rate, step: 0.0001, value: @rate&.rub_to_thb || 0.37, class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" %>
        <p class="text-sm text-gray-500 mt-1">Текущий курс: <%= @rate&.rub_to_thb || '0.37' %></p>
      </div>

      <%= f.hidden_field :currency_from, value: 'rub' %>
      <%= f.hidden_field :currency_to, value: 'thb' %>

      <!-- Имя клиента (опционально) -->
      <div>
        <%= f.label :client_name, "Имя клиента (опционально)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :client_name, placeholder: "Иван Иванов", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg" %>
      </div>

      <!-- Телефон клиента (опционально) -->
      <div>
        <%= f.label :client_phone, "Телефон клиента (опционально)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.telephone_field :client_phone, placeholder: "+79991234567", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg" %>
      </div>

      <!-- Заметка -->
      <div>
        <%= f.label :note, "Заметка (опционально)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :note, rows: 3, placeholder: "Заметка для себя", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg" %>
      </div>

      <!-- Кнопки -->
      <div class="flex gap-4">
        <%= f.submit "Создать ссылку", class: "btn-primary flex-1 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700" %>
        <%= link_to "Отмена", manager_dashboard_path, class: "btn flex-1 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 text-center" %>
      </div>
    <% end %>
  </div>
</div>
