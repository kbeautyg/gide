<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Dashboard Менеджера</h1>
    <p class="text-gray-600 mt-2">Добро пожаловать, <%= current_user.full_name %>!</p>
  </div>

  <!-- Статистика -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-600">Всего ссылок</div>
      <div class="text-3xl font-bold text-blue-600"><%= @stats[:total_links] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-600">Активных</div>
      <div class="text-3xl font-bold text-green-600"><%= @stats[:active_links] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-600">Транзакций</div>
      <div class="text-3xl font-bold text-purple-600"><%= @stats[:total_transactions] %></div>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <div class="text-sm text-gray-600">Завершено</div>
      <div class="text-3xl font-bold text-indigo-600"><%= @stats[:completed_transactions] %></div>
    </div>
  </div>

  <!-- Быстрые действия -->
  <div class="mb-8">
    <%= link_to "Создать платежную ссылку", new_manager_payment_link_path, class: "btn-primary inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700" %>
  </div>

  <!-- Последние платежные ссылки -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-semibold">Последние платежные ссылки</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Сумма</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Курс</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Получит</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Статус</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Создано</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @payment_links.each do |link| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap"><%= number_to_currency(link.amount_from, unit: '₽') %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= link.rate %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= number_to_currency(link.amount_to, unit: '฿') %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if link.active? %>
                  <span class="badge badge-pending">Активна</span>
                <% elsif link.completed? %>
                  <span class="badge badge-completed">Оплачена</span>
                <% else %>
                  <span class="badge badge-declined">Истекла</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= link.created_at.strftime('%d.%m.%Y %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Последние транзакции -->
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-semibold">Последние транзакции</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Клиент</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Сумма</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Получил</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Статус</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Дата</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @transactions.each do |transaction| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= transaction.client_name || 'Анонимный' %>
                <div class="text-xs text-gray-500"><%= transaction.client_phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap"><%= number_to_currency(transaction.amount_from, unit: '₽') %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= number_to_currency(transaction.amount_to, unit: '฿') %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="badge badge-completed">Завершена</span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= transaction.created_at.strftime('%d.%m.%Y %H:%M') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
