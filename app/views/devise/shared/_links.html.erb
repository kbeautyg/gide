<%- if controller_name != 'sessions' %>
  <%= link_to "Войти", new_session_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-medium" %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <div class="mt-2">
    <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "text-sm text-gray-600 hover:text-gray-800" %>
  </div>
<% end %>
