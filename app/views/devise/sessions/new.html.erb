<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 px-4">
  <div class="max-w-md w-full">
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <!-- Logo -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">FastChange 3.0</h1>
        <p class="text-gray-600 mt-2">Вход в систему</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <!-- Phone input -->
        <div>
          <%= f.label :phone, "Телефон", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.telephone_field :phone, autofocus: true, placeholder: "+79991234567", 
              class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <!-- Password input -->
        <div>
          <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Введите пароль",
              class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <!-- Remember me -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <%= f.label :remember_me, "Запомнить меня", class: "ml-2 block text-sm text-gray-700" %>
          </div>
        <% end %>

        <!-- Submit button -->
        <div>
          <%= f.submit "Войти", class: "btn-primary w-full py-3 px-4 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150" %>
        </div>
      <% end %>

      <!-- Links -->
      <div class="mt-6 text-center text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-sm text-gray-600 mt-8">
      FastChange 3.0 © <%= Time.current.year %>
    </p>
  </div>
</div>
