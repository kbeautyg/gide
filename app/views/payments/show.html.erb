<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 px-4">
  <div class="max-w-md w-full">
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <!-- Logo -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">FastChange 3.0</h1>
        <p class="text-gray-600 mt-2">Обмен валюты</p>
      </div>

      <!-- Информация об обмене -->
      <div class="bg-blue-50 rounded-lg p-6 mb-6">
        <div class="text-center">
          <div class="text-sm text-gray-600 mb-2">Вы платите</div>
          <div class="text-4xl font-bold text-gray-900"><%= number_to_currency(@payment_link.amount_from, unit: '₽', precision: 0) %></div>
          
          <div class="my-4">
            <svg class="mx-auto h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
          
          <div class="text-sm text-gray-600 mb-2">Вы получите</div>
          <div class="text-4xl font-bold text-green-600"><%= number_to_currency(@payment_link.amount_to, unit: '฿', precision: 0) %></div>
          
          <div class="text-xs text-gray-500 mt-3">
            Курс: 1 ₽ = <%= @payment_link.rate %> ฿
          </div>
        </div>
      </div>

      <!-- Форма подтверждения -->
      <%= form_with url: process_payment_path(@payment_link.token), method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= label_tag :client_name, "Ваше имя", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= text_field_tag :client_name, @payment_link.client_name, placeholder: "Иван Иванов", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <div>
          <%= label_tag :client_phone, "Ваш телефон", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= telephone_field_tag :client_phone, @payment_link.client_phone, placeholder: "+79991234567", class: "input w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500", required: true %>
        </div>

        <%= submit_tag "Подтвердить оплату", class: "w-full py-4 px-4 bg-green-600 text-white font-bold rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150" %>
      <% end %>

      <p class="text-xs text-center text-gray-500 mt-6">
        После подтверждения менеджер свяжется с вами для завершения обмена
      </p>
    </div>

    <!-- Footer -->
    <p class="text-center text-sm text-gray-600 mt-8">
      FastChange 3.0 © <%= Time.current.year %>
    </p>
  </div>
</div>
